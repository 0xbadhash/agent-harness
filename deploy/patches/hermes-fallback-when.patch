--- /dev/null
+++ b/tests/agent/test_fallback_when_gate.py
@@ -0,0 +1,101 @@
+"""Per-entry ``when:`` gate on the fallback chain.
+
+A fallback entry may list the ``FailoverReason`` values it is allowed to serve:
+
+    fallback_providers:
+      - provider: venice
+        model: deepseek-v4-1-flash-uncensored
+        when: [billing]
+
+Absent or empty ``when`` keeps the historical behavior (every reason). These tests
+pin that a gated entry is skipped for other reasons, is left in place so a later
+billing attempt can still use it, and that an ungated entry is unaffected.
+"""
+
+from unittest.mock import MagicMock, patch
+
+from run_agent import AIAgent
+from agent.error_classifier import FailoverReason
+
+
+def _make_agent(fallback_model=None):
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        agent = AIAgent(
+            api_key="test-key",
+            base_url="https://openrouter.ai/api/v1",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+            fallback_model=fallback_model,
+        )
+        agent.client = MagicMock()
+        return agent
+
+
+def _mock_client(base_url="https://openrouter.ai/api/v1", api_key="fb-key"):
+    mock = MagicMock()
+    mock.base_url = base_url
+    mock.api_key = api_key
+    return mock
+
+
+BILLING_ONLY = [
+    {"provider": "deepseek", "model": "deepseek-v4-1-flash-uncensored", "when": ["billing"]},
+]
+
+
+class TestWhenGate:
+    def test_rate_limit_does_not_switch_a_billing_only_entry(self):
+        agent = _make_agent(fallback_model=BILLING_ONLY)
+        with patch(
+            "agent.auxiliary_client.resolve_provider_client",
+            return_value=(_mock_client(), "resolved"),
+        ):
+            assert agent._try_activate_fallback(reason=FailoverReason.rate_limit) is False
+            # The gated entry must stay available for the next attempt.
+            assert agent._fallback_index == 0
+            assert agent._try_activate_fallback(reason=FailoverReason.billing) is True
+
+    def test_other_reasons_stay_on_the_primary(self):
+        agent = _make_agent(fallback_model=BILLING_ONLY)
+        with patch(
+            "agent.auxiliary_client.resolve_provider_client",
+            return_value=(_mock_client(), "resolved"),
+        ):
+            for reason in (
+                FailoverReason.timeout,
+                FailoverReason.server_error,
+                FailoverReason.overloaded,
+                FailoverReason.upstream_rate_limit,
+            ):
+                assert agent._try_activate_fallback(reason=reason) is False
+
+    def test_missing_reason_is_blocked_by_the_gate(self):
+        agent = _make_agent(fallback_model=BILLING_ONLY)
+        assert agent._try_activate_fallback() is False
+
+    def test_ungated_entry_keeps_switching_on_rate_limit(self):
+        chain = [{"provider": "openai", "model": "gpt-4o"}]
+        agent = _make_agent(fallback_model=chain)
+        with patch(
+            "agent.auxiliary_client.resolve_provider_client",
+            return_value=(_mock_client(), "resolved"),
+        ):
+            assert agent._try_activate_fallback(reason=FailoverReason.rate_limit) is True
+
+    def test_gate_skips_forward_to_a_later_allowed_entry(self):
+        chain = [
+            {"provider": "deepseek", "model": "deepseek-v4-1-flash-uncensored", "when": ["billing"]},
+            {"provider": "openai", "model": "gpt-4o", "when": ["rate_limit"]},
+        ]
+        agent = _make_agent(fallback_model=chain)
+        with patch(
+            "agent.auxiliary_client.resolve_provider_client",
+            return_value=(_mock_client(), "resolved"),
+        ):
+            assert agent._try_activate_fallback(reason=FailoverReason.rate_limit) is True
+            assert agent.provider == "openai"
