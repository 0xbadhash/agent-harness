+def _fallback_entry_allows_reason(fb: dict[str, Any], reason: FailoverReason | None) -> bool:
+    """Honor an optional per-entry ``when:`` gate.
+
+    ``when`` lists the :class:`FailoverReason` values this entry may serve. Absent or
+    empty keeps the historical behavior (every reason). Any other reason skips the
+    entry, so a chain can be limited to, for example, credit exhaustion only.
+    """
+    wanted = fb.get("when")
+    if not isinstance(wanted, list) or not wanted:
+        return True
+    names = {str(x).strip().lower() for x in wanted if isinstance(x, str)}
+    if not names:
+        return True
+    current = str(getattr(reason, "value", reason) or "").lower()
+    return current in names
+
