[Unit]
Description=Agent harness morning triage after night_shift (feedback loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=debian
Group=debian
WorkingDirectory=/home/debian/agent-harness
Environment=NIGHT_SHIFT_PRODUCTS_FILE=/home/debian/agent-harness/config/night_shift_products.yaml
Environment=PATH=/home/debian/agent-harness/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'PY="/home/debian/agent-harness/.venv/bin/python"; if [ ! -x "$PY" ]; then PY=/usr/bin/python3; fi; exec "$PY" /home/debian/agent-harness/scripts/night_shift_morning_triage.py --recheck'
# Exit 1 (any FAIL) still counts as completed oneshot for timer accounting
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
